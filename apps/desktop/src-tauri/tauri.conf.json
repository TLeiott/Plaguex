{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plaguex",
  "version": "1.0.0",
  "identifier": "dev.plaguex.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm --filter @plaguex/web dev",
    "beforeBuildCommand": "pnpm --filter @plaguex/web build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Plaguex",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0b0b0f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/downloads/**", "$APPDATA/downloads/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "A fast, no-nonsense Plex client",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
